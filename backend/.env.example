PORT=3000
NODE_ENV=development

DATABASE_URL="postgresql://usuario:password@127.0.0.1:5432/gym?schema=public"

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

RESEND_API_KEY=
# Remitente (onboarding@resend.dev funciona sin dominio propio)
EMAIL_REMITENTE="BEAST MODE <onboarding@resend.dev>"
# Modo pruebas: si se define, todos los correos se envían aquí (dueño de la cuenta de Resend)
EMAIL_DESTINO_PRUEBAS=
# URL del frontend para los enlaces de los correos
APP_URL=http://localhost:4200

CORS_ORIGIN=http://localhost:4200

# Personas máximas dentro del gym a la vez (para el medidor de aforo)
AFORO_CAPACIDAD=60
